CREATE SCHEMA IF NOT EXISTS content;

CREATE TABLE content.restaurantes (
    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(120) NOT NULL,
    ciudad VARCHAR(80) NOT NULL,
    direccion VARCHAR(200) NOT NULL DEFAULT '',
    telefono VARCHAR(30) NOT NULL DEFAULT ''
);

CREATE TABLE content.platos (
    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(120) NOT NULL,
    precio NUMERIC(10,2) NOT NULL,
    disponible BOOLEAN NOT NULL DEFAULT TRUE,
    restaurante_id INTEGER NOT NULL,

    CONSTRAINT plato_precio_positivo
        CHECK (precio > 0),

    CONSTRAINT platos_restaurante_fk
        FOREIGN KEY (restaurante_id)
        REFERENCES content.restaurantes(id)
        ON DELETE CASCADE
);

CREATE TABLE content.pedidos (
    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    cliente VARCHAR(255) NOT NULL,
    restaurante_id INTEGER NOT NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'pendiente',
    fecha TIMESTAMP WITH TIME ZONE NOT NULL
        DEFAULT CURRENT_TIMESTAMP,
    total NUMERIC(10,2) NOT NULL DEFAULT 0.00,

    CONSTRAINT pedido_estado_valido
        CHECK (
            estado IN (
                'pendiente',
                'en_preparacion',
                'listo',
                'entregado',
                'cancelado'
            )
        ),

    CONSTRAINT pedido_total_no_negativo
        CHECK (total >= 0),

    CONSTRAINT pedidos_restaurante_fk
        FOREIGN KEY (restaurante_id)
        REFERENCES content.restaurantes(id)
        ON DELETE CASCADE
);

CREATE TABLE content.items_pedido (
    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    pedido_id INTEGER NOT NULL,
    plato_id INTEGER NOT NULL,
    cantidad INTEGER NOT NULL,
    precio_unitario NUMERIC(10,2) NOT NULL,

    CONSTRAINT item_cantidad_valida
        CHECK (cantidad BETWEEN 1 AND 20),

    CONSTRAINT item_precio_no_negativo
        CHECK (precio_unitario >= 0),

    CONSTRAINT items_pedido_pedido_fk
        FOREIGN KEY (pedido_id)
        REFERENCES content.pedidos(id)
        ON DELETE CASCADE,

    CONSTRAINT items_pedido_plato_fk
        FOREIGN KEY (plato_id)
        REFERENCES content.platos(id)
        ON DELETE CASCADE
);

CREATE INDEX idx_platos_restaurante
    ON content.platos(restaurante_id);

CREATE INDEX idx_pedidos_cliente
    ON content.pedidos(cliente);

CREATE INDEX idx_pedidos_restaurante
    ON content.pedidos(restaurante_id);

CREATE INDEX idx_items_pedido_pedido
    ON content.items_pedido(pedido_id);

CREATE INDEX idx_items_pedido_plato
    ON content.items_pedido(plato_id);
